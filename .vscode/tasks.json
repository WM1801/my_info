{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Asciidoctor PDF",
            "type": "shell",
            "command": "C:\\Ruby40-x64\\bin\\asciidoctor-pdf.bat",
            "args": [
                "-a", "pdf-theme=default-with-fallback-font",
                "-a", "pdf-fontsdir=GEM_FONTS_DIR",
                "-a", "encoding=UTF-8",
                "${relativeFile}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Generate Index",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\generate-index.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [], 
            "dependsOn": ["Asciidoctor PDF"],
            "dependsOrder": "sequence"
        }
    ]
}